# python
__pycache__/
*.pyc
*.egg-info/
build/
dist/

# venv / tooling
.venv/
.ruff_cache/
.mypy_cache/
.pytest_cache/

# runtime artifacts (regenerated by kavach)
campaigns/*
!campaigns/.gitkeep
*.db
report.md
report-demo.md

# corpora: heavy + regenerable via `kavach seeds`
targets/*/seeds/*
!targets/pdf/seeds/.gitkeep
!targets/image/seeds/.gitkeep
!targets/toy_crash/seeds/**
targets/*/seeds_minimized/
targets/*/seeds_archive/

# generated target packs (kavach init output)
targets/demo_hello/

# misc
nohup.out
*.log
